{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guess-who-tf-family",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "GameCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameCoordinator"] }
  ]
}
